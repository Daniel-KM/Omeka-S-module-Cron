{
    "name": "daniel-km/omeka-s-module-cron",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Provide a cron system for scheduled tasks via page load fallback or server cron, with event-based task registration for modules.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "administration",
        "cron"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Cron",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Cron/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2412)": {
        "omeka/omeka-s": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CronTest\\": "tests/CronTest/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "extra": {
        "installer-name": "Cron"
    }
}
